---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Realisations from '../components/Realisations.astro';
import Stack from '../components/Stack.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { load, publicFileExists } from '../lib/data.js';

const site = load('site');
const accueil = load('accueil');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cvHref = `${base}${site.cv}`;
if (!publicFileExists(site.cv)) {
  console.warn(`\n[portfolio] TODO Mano : public/${site.cv} est absent. Les boutons CV mènent à une 404.\n`);
}
---
<BaseLayout titre={site.meta.titre} description={site.meta.description}>
  <Header slot="header" nom={site.nom} nav={site.nav} cvHref={cvHref} />
  <Hero a={accueil} cvHref={cvHref} />
  <Experience data={load('experience')} />
  <Realisations data={load('realisations')} />
  <Stack data={load('stack')} />
  <Certifications data={load('certifications')} />
  <Contact c={site.contact} cvHref={cvHref} cvLabel={accueil.actions.cv} />
  <Footer slot="footer" nom={site.nom} cvHref={cvHref} />
</BaseLayout>

<script>
  import '../scripts/prouve-le.js';
</script>
