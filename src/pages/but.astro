---
// Page pour l'IUT : compétences du BUT R&T croisées avec les projets.
// Volontairement absente du menu principal.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { load } from '../lib/data.js';

const site = load('site');
const data = load('competences');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cvHref = `${base}${site.cv}`;
---
<BaseLayout titre={`Compétences BUT R&T · ${site.nom}`} description="Compétences du BUT R&T croisées avec mes projets." noindex>
  <Header slot="header" nom={site.nom} nav={site.nav} cvHref={cvHref} accueil={base} />
  <section class="section">
    <div class="wrap">
      <header class="section__head">
        <p class="mono section__label">BUT R&T · Cybersécurité</p>
        <h1 class="section__title">Compétences du BUT.</h1>
        <p class="section__intro">{data.sous_titre}</p>
      </header>

      <div class="mx" data-matrice>
        <div class="mx__filters" role="group" aria-label="Mettre en évidence une compétence" data-matrice-filtres hidden>
          {data.competences.map((c) => (
            <button type="button" class="mx__f" aria-pressed="false" data-comp={c.id}>
              <span class="mx__f-n">{c.nom}</span><span class="mx__f-d">{c.detail}</span>
            </button>
          ))}
        </div>
        <div class="mx__table">
          <table>
            <caption class="visually-hidden">Compétences du BUT R&T mobilisées par chaque projet</caption>
            <thead>
              <tr>
                <th scope="col" class="mx__p"><span class="mono">Projet</span></th>
                {data.competences.map((c) => (
                  <th scope="col" data-col={c.id}><abbr title={`${c.nom} ${c.detail}`} class="mono">{c.court}</abbr><span class="mx__long mono">{c.nom}</span></th>
                ))}
              </tr>
            </thead>
            <tbody>
              {data.lignes.map((l) => (
                <tr data-row={l.competences.join(' ')}>
                  <th scope="row"><a href={`${base}#${l.ancre}`}>{l.titre}</a></th>
                  {data.competences.map((c) => {
                    const oui = l.competences.includes(c.id);
                    return (
                      <td data-col={c.id} class:list={[oui && 'is-yes']}>
                        <span aria-hidden="true">{oui ? '●' : '·'}</span><span class="visually-hidden">{oui ? 'oui' : 'non'}</span>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mx__legend mono">ADM Administrer · CON Connecter · PRO Programmer · SÉC Sécuriser · SUR Surveiller</p>
      </div>
      <p class="mx__back"><a href={base}>Retour au portfolio <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
  <Footer slot="footer" nom={site.nom} cvHref={cvHref} accueil={base} />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-matrice]');
  if (root) {
    const filtres = root.querySelector<HTMLElement>('[data-matrice-filtres]')!;
    const boutons = [...filtres.querySelectorAll<HTMLButtonElement>('button')];
    let actif: string | null = null;
    const afficher = (id: string | null) => {
      root.querySelectorAll<HTMLElement>('[data-col]').forEach((el) => el.classList.toggle('is-col', el.dataset.col === id));
      root.querySelectorAll<HTMLElement>('[data-row]').forEach((tr) => {
        const on = !!id && tr.dataset.row!.split(' ').includes(id);
        tr.classList.toggle('is-on', on);
        tr.classList.toggle('is-off', !!id && !on);
      });
    };
    boutons.forEach((b) => {
      b.addEventListener('click', () => {
        actif = actif === b.dataset.comp ? null : b.dataset.comp!;
        boutons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.comp === actif)));
        afficher(actif);
      });
      b.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') afficher(b.dataset.comp!); });
      b.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') afficher(actif); });
    });
    filtres.hidden = false;
  }
</script>

<style>
  .mx__filters { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); }
  .mx__f { display: grid; text-align: left; flex: 1 1 10rem; min-height: var(--tap); padding: 0.5rem 0.8rem; background: transparent; border: 0; box-shadow: inset 0 0 0 1.5px var(--dark); color: var(--fg); font: inherit; cursor: pointer; }
  .mx__f-n { font-weight: 700; }
  .mx__f-d { font-size: 0.8rem; color: var(--fg-mute); line-height: 1.3; }
  .mx__f:hover { box-shadow: inset 0 0 0 1.5px var(--accent); }
  .mx__f[aria-pressed='true'] { background: var(--dark); color: var(--light); }
  .mx__f[aria-pressed='true'] .mx__f-d { color: var(--on-dark-mute); }
  .mx__table table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .mx__table th, .mx__table td { padding: var(--space-2); border-bottom: 1px solid var(--line); text-align: center; transition: background-color 150ms, opacity 150ms; }
  .mx__table thead th { border-bottom: 2px solid var(--dark); font-weight: 500; }
  .mx__p { width: 42%; text-align: left !important; }
  .mx__table tbody th { text-align: left; font-weight: 600; font-size: var(--fs-sm); }
  .mx__table abbr { text-decoration: none; }
  .mx__long { display: none; }
  .mx__table td { color: var(--fg-mute); }
  .mx__table td.is-yes { color: var(--fg); }
  .mx__table .is-col { background: rgb(43 68 255 / 0.08); }
  .mx__table td.is-col.is-yes { color: var(--accent); }
  .mx__table tr.is-off { opacity: 0.35; }
  .mx__legend { margin-top: var(--space-3); color: var(--fg-mute); text-transform: none; }
  .mx__back { margin-top: var(--space-6); }
  .mx__back a { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 600; color: var(--accent); }
  @media (min-width: 720px) {
    .mx__p { width: 30%; }
    .mx__table abbr { display: none; }
    .mx__long { display: inline; }
    .mx__legend { display: none; }
  }
</style>
