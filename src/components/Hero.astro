---
import { inline } from '../lib/text.js';
import Todo from './Todo.astro';
interface Props { a: any; cvHref: string }
const { a, cvHref } = Astro.props;
const [prenom, ...reste] = a.nom.split(' ');
---
<section class="hero" id="top" aria-labelledby="hero-nom">
  <div class="hero__left">
    <p class="mono hero__kicker"><span class="dot" aria-hidden="true"></span>{a.situation}</p>
    <h1 id="hero-nom" class="hero__name">{prenom}<br />{reste.join(' ')}</h1>
    <p class="hero__role">{a.role}. <span>{a.domaine}.</span></p>
    {a.recherche && <p class="hero__recherche">{a.recherche}</p>}
    <Todo texte={a.recherche ? '' : 'préciser ce que tu recherches après 2027 (accueil.yaml, champ recherche)'} />
    <p class="hero__hook">{a.accroche}</p>
    <div class="hero__cta">
      <a class="btn btn--dark btn--big" href={cvHref} download>{a.actions.cv} <span aria-hidden="true">↓</span></a>
      <a class="btn btn--line btn--big" href="#contact">{a.actions.contact} <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="hero__block on-dark" aria-labelledby="hero-chiffres">
    <h2 id="hero-chiffres" class="visually-hidden">Trois réalisations chiffrées</h2>
    <ol class="nums">
      {a.chiffres.map((c, i) => (
        <li>
          <a href={`#${c.ancre}`} class="nums__link">
            <span class="mono nums__ctx">0{i + 1} · {c.contexte}</span>
            <span class="nums__val">{c.chiffre}<small> {c.unite}</small></span>
            <span class="nums__txt">{c.texte}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="hero__now">
      <span set:html={inline(a.en_cours.texte)} />
      <a href={`#${a.en_cours.ancre}`}>Voir le projet <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .hero { display: grid; }
  .hero__left { padding: var(--space-7) var(--gutter) var(--space-7); display: flex; flex-direction: column; }
  .hero__kicker { display: flex; align-items: center; gap: var(--space-3); color: var(--fg-mute); text-transform: none; font-size: 0.82rem; }
  .dot { width: 9px; height: 9px; background: var(--accent); flex: none; }
  .hero__name {
    font-size: min(var(--fs-hero), 17svh);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.84;
    margin: var(--space-5) 0 var(--space-6);
    margin-left: -0.04em;
  }
  .hero__role { font-size: var(--fs-xl); font-weight: 650; line-height: 1.15; letter-spacing: -0.02em; max-width: 22ch; }
  .hero__role span { color: var(--accent); }
  .hero__recherche { margin-top: var(--space-3); font-weight: 600; }
  .hero__hook { margin-top: var(--space-4); color: var(--fg-mute); font-size: var(--fs-lg); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  .hero__block { background: var(--dark); color: var(--on-dark); padding: var(--space-6) var(--gutter) var(--space-7); }
  .nums { list-style: none; padding: 0; }
  .nums li + li { border-top: 1px solid var(--on-dark-line); }
  .nums__link { display: grid; gap: 0.35rem; padding: var(--space-5) 0; text-decoration: none; color: inherit; }
  .nums li:first-child .nums__link { padding-top: 0; }
  .nums__link:hover .nums__val { color: var(--accent-on-dark); }
  .nums__ctx { color: var(--on-dark-mute); }
  .nums__val { font-size: var(--fs-num); font-weight: 800; letter-spacing: -0.045em; line-height: 0.95; transition: color 150ms; }
  .nums__val small { font-size: 0.34em; font-weight: 600; letter-spacing: -0.01em; color: var(--on-dark-mute); }
  .nums__txt { color: var(--on-dark); opacity: 0.86; max-width: 46ch; }
  .hero__now {
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--accent-on-dark);
    color: var(--on-dark-mute);
    font-size: 0.95rem;
  }
  .hero__now :global(strong) { color: var(--on-dark); }
  .hero__now a { display: flex; width: fit-content; align-items: center; min-height: var(--tap); color: var(--accent-on-dark); font-weight: 600; text-decoration: none; }
  .hero__now a:hover { color: var(--on-dark); }

  @media (min-width: 960px) {
    .hero { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); min-height: calc(100svh - var(--header-h)); }
    .hero__left { padding: 7svh var(--space-7) var(--space-6) var(--gutter); }
    .hero__block { padding: 7svh var(--gutter) var(--space-5) var(--space-7); display: flex; flex-direction: column; }
    .nums__link { padding: var(--space-4) 0; }
    .nums__val { font-size: min(var(--fs-num), 8svh); }
    .hero__now { margin-top: auto; }
  }
  @media (min-width: 1600px) {
    .hero__left { padding-left: calc((100vw - var(--page-max)) / 2 + var(--gutter)); }
  }
</style>
