---
import Monogramme from './Monogramme.astro';
import { inline } from '../lib/text.js';
import { publicFileExists } from '../lib/data.js';

const { site } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cvExiste = publicFileExists(site.cv);
---
<section class="hero" id="top" aria-labelledby="hero-nom">
  <div class="wrap hero__grid">
    <div class="hero__main">
      <p class="mono hero__kicker">Dossier de compétences <span aria-hidden="true">·</span> Pl. 00</p>
      <h1 id="hero-nom" class="hero__name">{site.nom}</h1>
      <p class="hero__role">{site.positionnement}</p>

      <!-- Cote : l'écart entre maquette et production -->
      <div class="cote" aria-hidden="true">
        <span class="cote__label mono">Maquette</span>
        <span class="cote__line"><span class="cote__bar"></span></span>
        <span class="cote__label mono">Production</span>
      </div>

      <p class="hero__problem">{site.problematique}</p>
      <p class="hero__note" set:html={inline(site.annotation_accueil)} />

      <div class="hero__actions">
        <a class="btn btn--primary" href="#projets">{site.boutons.projets} <span aria-hidden="true">→</span></a>
        <a class="btn" href="#contact">{site.boutons.contact}</a>
        {cvExiste
          ? <a class="hero__cv" href={`${base}${site.cv}`} download>CV (PDF) <span aria-hidden="true">↓</span></a>
          : <Fragment set:html="<!-- TODO Mano : CV absent, déposer public/cv/CV_Mano_Lecocq.pdf pour afficher le lien -->" />}
      </div>
    </div>

    <aside class="titleblock" aria-label="Cartouche du dossier">
      <div class="titleblock__head">
        <Monogramme size={72} />
        <div>
          <p class="mono">Plan n° 00</p>
          <p class="titleblock__title">Portfolio</p>
        </div>
      </div>
      <dl>
        {site.cartouche.map((r) => (
          <div class="titleblock__row">
            <dt class="mono">{r.label}</dt>
            <dd>{r.valeur}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-7) var(--space-8); }
  .hero__grid { display: grid; gap: var(--space-7); align-items: start; }

  .hero__kicker { color: var(--accent-ink); margin-bottom: var(--space-3); }
  .hero__name {
    font-size: var(--fs-display);
    font-weight: 820;
    font-stretch: 125%;
    letter-spacing: -0.02em;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .hero__role {
    margin-top: var(--space-4);
    font-size: var(--fs-lead);
    color: var(--ink-soft);
  }

  /* Cote fléchée */
  .cote {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block: var(--space-6) var(--space-5);
    max-width: 40rem;
  }
  .cote__label { flex: none; color: var(--ink); font-size: 0.7rem; }
  .cote__line {
    position: relative;
    flex: 1;
    height: 18px;
    border-inline: 1.5px solid var(--ink);
  }
  .cote__bar {
    position: absolute;
    left: 0; right: 0; top: 50%;
    height: 1.5px;
    background: var(--accent);
    transform-origin: left center;
    animation: cote-draw 1.1s 0.3s var(--ease) both;
  }
  .cote__bar::before, .cote__bar::after {
    content: '';
    position: absolute;
    top: -4px;
    border-block: 4.75px solid transparent;
  }
  .cote__bar::before { left: 0; border-right: 9px solid var(--accent); }
  .cote__bar::after { right: 0; border-left: 9px solid var(--accent); }
  @keyframes cote-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .hero__problem {
    font-family: var(--f-title);
    font-size: var(--fs-problem);
    font-weight: 600;
    font-stretch: 100%;
    line-height: 1.18;
    max-width: 24ch;
    text-wrap: balance;
    margin-bottom: var(--space-4);
  }
  .hero__note {
    color: var(--ink-soft);
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent);
    max-width: 52ch;
    margin-bottom: var(--space-6);
  }

  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .hero__cv {
    display: inline-flex; align-items: center; gap: 0.3rem;
    min-height: var(--tap);
    font-family: var(--f-mono); font-size: 0.86rem;
  }

  /* Cartouche de plan */
  .titleblock {
    border: 1.5px solid var(--ink);
    background: var(--paper-raised);
    font-size: var(--fs-small);
    box-shadow: 6px 6px 0 var(--grid-major);
  }
  .titleblock__head {
    display: flex; align-items: center; gap: var(--space-4);
    padding: var(--space-4);
    border-bottom: 1.5px solid var(--ink);
  }
  .titleblock__head p { margin: 0; }
  .titleblock__title { font-family: var(--f-title); font-weight: 750; font-stretch: 120%; font-size: 1.3rem; }
  .titleblock dl { margin: 0; }
  .titleblock__row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    border-bottom: var(--stroke) solid var(--line);
  }
  .titleblock__row:last-child { border-bottom: 0; }
  .titleblock__row dt { padding: var(--space-2) var(--space-3); border-right: var(--stroke) solid var(--line); font-size: 0.68rem; align-self: center; }
  .titleblock__row dd { margin: 0; padding: var(--space-2) var(--space-3); }

  @media (min-width: 900px) {
    .hero { padding-block: var(--space-8); }
    .hero__grid { grid-template-columns: minmax(0, 1fr) 19rem; gap: var(--space-8); }
    .titleblock { margin-top: var(--space-7); }
  }
</style>
