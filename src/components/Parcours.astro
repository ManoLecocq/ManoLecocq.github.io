---
import Planche from './Planche.astro';
import Todo from './Todo.astro';
const { data, planche } = Astro.props;
const colonnes = [
  { titre: 'Expériences', items: data.experiences },
  { titre: 'Études', items: data.etudes },
];
---
<Planche num={planche.num} titre={planche.titre} id={planche.ancre} sousTitre={data.sous_titre}>
  <div class="frises">
    {colonnes.map((col) => (
      <section class="frise" aria-label={col.titre}>
        <h3 class="mono frise__titre">{col.titre}</h3>
        <ol class="frise__liste" role="list">
          {col.items.map((it) => (
            <li class:list={['etape', it.discret && 'etape--discret']} data-reveal>
              <p class="etape__periode mono">{it.periode}</p>
              <p class="etape__titre">{it.titre}</p>
              <p class="etape__lieu">{it.lieu}</p>
              {it.detail && <p class="etape__detail">{it.detail}</p>}
              {it.qualites && <p class="etape__qualites mono">{it.qualites.join(' · ')}</p>}
              {it.lien && <a class="etape__lien mono" href={`#${it.lien}`}>Voir la fiche <span aria-hidden="true">→</span></a>}
              <Todo texte={it.todo} />
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Planche>

<style>
  .frises { display: grid; gap: var(--space-7); }
  .frise__titre { color: var(--accent-ink); font-size: 0.75rem; font-weight: 500; margin-bottom: var(--space-4); font-stretch: 100%; }
  .frise__liste { list-style: none; margin: 0; padding: 0 0 0 var(--space-5); border-left: 1.5px solid var(--ink); }
  .etape { position: relative; padding-bottom: var(--space-6); }
  .etape:last-child { padding-bottom: 0; }
  .etape::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-5) - 6px);
    top: 0.3rem;
    width: 10px; height: 10px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
  }
  .etape:first-child::before { background: var(--accent); border-color: var(--accent); }
  .etape p { margin: 0; }
  .etape__titre { font-family: var(--f-title); font-weight: 700; font-stretch: 105%; font-size: 1.08rem; line-height: 1.3; margin-top: var(--space-1) !important; }
  .etape__lieu { color: var(--ink-soft); }
  .etape__detail { margin-top: var(--space-2) !important; font-size: var(--fs-small); }
  .etape__qualites { margin-top: var(--space-2) !important; text-transform: none; }
  .etape__lien { display: inline-flex; align-items: center; min-height: var(--tap); text-transform: none; }

  .etape--discret .etape__titre { font-size: 0.98rem; font-weight: 600; }
  .etape--discret .etape__lieu, .etape--discret .etape__detail { font-size: 0.88rem; }
  .etape--discret::before { width: 8px; height: 8px; left: calc(-1 * var(--space-5) - 5px); }

  @media (min-width: 860px) { .frises { grid-template-columns: 1.15fr 1fr; gap: var(--space-8); } }
</style>
