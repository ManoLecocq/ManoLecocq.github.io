---
// Monogramme « ML » dessiné comme un cartouche de plan (remplace la photo).
// TODO Mano : si tu veux une photo, l'ajouter dans public/ et la placer ici.
interface Props { size?: number; class?: string }
const { size = 64, class: className } = Astro.props;
---
<svg class:list={['monogramme', className]} width={size} height={size} viewBox="0 0 64 64" role="img" aria-label="Monogramme ML">
  <rect x="1.5" y="1.5" width="61" height="61" fill="none" stroke="currentColor" stroke-width="1.5" />
  <rect x="5.5" y="5.5" width="53" height="53" fill="none" stroke="currentColor" stroke-width="0.75" />
  <!-- repères d'angle -->
  <path d="M5.5 14 H1.5 M50 5.5 V1.5 M58.5 50 H62.5 M14 58.5 V62.5" stroke="var(--accent)" stroke-width="1.5" />
  <text x="32" y="40.5" text-anchor="middle" font-family="var(--f-title)" font-weight="800" font-size="22" letter-spacing="-0.5" fill="currentColor" style="font-stretch:125%">ML</text>
  <line x1="14" y1="46" x2="50" y2="46" stroke="var(--accent)" stroke-width="1.5" />
</svg>
