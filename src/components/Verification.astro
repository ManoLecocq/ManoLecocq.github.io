---
// Compteur « Affirmations vérifiées » fixé en bas de l'écran.
// Caché sans JS (les preuves sont alors toutes dépliées, il n'y a rien à compter).
import { total } from '../lib/affirmations.js';
interface Props { messageFin: string }
const { messageFin } = Astro.props;
---
<aside class="verif" data-verif aria-label="Suivi des preuves" hidden>
  <div class="wrap verif__inner">
    <p class="verif__count" aria-live="polite" aria-atomic="true">
      <span class="verif__label">Affirmations vérifiées :</span>
      <span class="verif__nums"><strong data-verif-n>0</strong> / {total}</span>
    </p>
    <span class="verif__gauge" aria-hidden="true"><span data-verif-bar></span></span>
    <button type="button" class="verif__next mono" data-verif-next>Suivante <span aria-hidden="true">↓</span></button>
    <p class="verif__done" data-verif-done role="status" hidden>
      <span>{messageFin}</span>
      <a href="#contact">Contact <span aria-hidden="true">→</span></a>
    </p>
  </div>
</aside>

<style>
  .verif {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 40;
    background: rgb(251 248 242 / 0.97);
    border-top: 1.5px solid var(--ink);
    font-size: var(--fs-small);
  }
  .verif__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    min-height: 3.25rem;
    padding-block: var(--space-1);
  }
  .verif__count { margin: 0; display: flex; gap: 0.4rem; align-items: baseline; font-family: var(--f-mono); font-size: 0.8rem; }
  .verif__count strong { color: var(--accent-ink); font-size: 1rem; }
  .verif__gauge { flex: 1; min-width: 4rem; max-width: 14rem; height: 4px; background: var(--grid-major); position: relative; }
  .verif__gauge span { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--accent); transition: width 300ms var(--ease); }
  .verif__next {
    min-height: var(--tap);
    padding: 0 var(--space-3);
    margin-left: auto;
    background: none;
    border: var(--stroke) solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink);
    cursor: pointer;
    font-size: 0.72rem;
  }
  .verif__next:hover { border-color: var(--accent); color: var(--accent-ink); }
  .verif__done { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); align-items: center; flex-basis: 100%; font-weight: 600; }
  .verif__done a { display: inline-flex; align-items: center; min-height: var(--tap); font-family: var(--f-mono); font-size: 0.8rem; }

  .verif.is-done .verif__next, .verif.is-done .verif__gauge { display: none; }
  .verif.is-done .verif__done { flex-basis: auto; }

  @media (max-width: 600px) {
    .verif.is-done .verif__count { display: none; }
    .verif__done { font-size: 0.85rem; flex-wrap: nowrap; justify-content: space-between; }
    .verif__done a { flex: none; }
  }
  @media (max-width: 420px) {
    .verif__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .verif__nums::before { content: 'Vérifiées '; font-size: 0.72rem; color: var(--ink-faint); }
  }
</style>
