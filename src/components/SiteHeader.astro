---
import Monogramme from './Monogramme.astro';
interface Props { nom: string; planches: { num: string; titre: string; ancre: string }[] }
const { nom, planches } = Astro.props;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="#top" aria-label={`${nom}, retour en haut`}>
      <Monogramme size={32} />
      <span class="site-header__name">{nom}</span>
    </a>

    <nav class="nav-desktop" aria-label="Sommaire">
      <ol>
        {planches.map((p) => (
          <li><a href={`#${p.ancre}`}><span class="mono">{p.num}</span> {p.titre}</a></li>
        ))}
      </ol>
    </nav>

    <!-- Mobile : <details> natif, fonctionne sans JS -->
    <details class="nav-mobile">
      <summary><span class="mono">Sommaire</span><span class="nav-mobile__icon" aria-hidden="true"></span></summary>
      <nav aria-label="Sommaire">
        <ol>
          {planches.map((p) => (
            <li><a href={`#${p.ancre}`}><span class="mono">Pl. {p.num}</span> {p.titre}</a></li>
          ))}
        </ol>
      </nav>
    </details>
  </div>
</header>

<script>
  // Referme le sommaire mobile après un clic sur un lien.
  const menu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.open = false; }));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(246 242 233 / 0.94);
    backdrop-filter: blur(6px);
    border-bottom: var(--stroke) solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.5rem;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    text-decoration: none;
    font-family: var(--f-title);
    font-weight: 700;
    font-stretch: 115%;
  }
  .site-header__brand:hover { color: var(--ink); }

  .nav-desktop { display: none; }
  .nav-desktop ol, .nav-mobile ol { list-style: none; margin: 0; padding: 0; }
  .nav-desktop ol { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); justify-content: flex-end; }
  .nav-desktop a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: var(--tap);
    font-size: var(--fs-small);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
  }
  .nav-desktop a:hover { border-bottom-color: var(--accent); color: var(--ink); }
  .nav-desktop .mono { font-size: 0.7rem; }

  .nav-mobile { position: relative; }
  .nav-mobile summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: var(--stroke) solid var(--line-strong);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    background: var(--paper-raised);
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile summary .mono { color: var(--ink); }
  .nav-mobile__icon, .nav-mobile__icon::before {
    display: block; width: 14px; height: 1.5px; background: var(--ink); position: relative;
  }
  .nav-mobile__icon::before { content: ''; position: absolute; top: 5px; }
  .nav-mobile__icon { transform: translateY(-2.5px); }
  .nav-mobile[open] .nav-mobile__icon { background: var(--accent); }
  .nav-mobile nav {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    width: min(18rem, calc(100vw - 2 * var(--gutter)));
    background: var(--paper-raised);
    border: var(--stroke) solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    padding: var(--space-2) 0;
  }
  .nav-mobile a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap);
    padding: 0 var(--space-4);
    text-decoration: none;
  }
  .nav-mobile a:hover { background: var(--accent-wash); }

  @media (min-width: 1000px) {
    .nav-desktop { display: block; }
    .nav-mobile { display: none; }
  }
</style>
