---
// Une affirmation « Prouve-le » et sa pièce jointe.
// Sans JS : le bouton reste caché et la pièce est affichée dépliée.
// Avec JS (scripts/prouve-le.js) : la pièce se replie et le bouton l'ouvre.
import { getAffirmation, total } from '../lib/affirmations.js';
import { inline } from '../lib/text.js';
import Statut from './Statut.astro';

interface Props { id: string }
const a = getAffirmation(Astro.props.id);
const pieceId = `piece-${a.id}`;
const totalStr = String(total).padStart(2, '0');
---
<div class="claim" id={`affirmation-${a.id}`} data-claim={a.id}>
  <p class="claim__line">
    <span class="claim__text">{a.phrase}</span>
    <button type="button" class="claim__btn" aria-expanded="true" aria-controls={pieceId} hidden>
      Prouve-le <span class="claim__arrow" aria-hidden="true">→</span>
    </button>
    <span class="claim__check mono" aria-hidden="true">✓ vérifiée</span>
  </p>

  <div class="piece" id={pieceId} role="region" aria-labelledby={`${pieceId}-titre`} tabindex="-1">
    <div class="piece__head">
      <span class="mono piece__tag">Pièce jointe {a.num}/{totalStr}</span>
      <span class="visually-hidden" id={`${pieceId}-titre`}>Preuve {a.num} : {a.phrase}</span>
      <button type="button" class="piece__close mono" hidden>Refermer <span aria-hidden="true">×</span></button>
    </div>

    {a.blocs.map((b) => (
      <div class:list={['bloc', `bloc--${b.type}`]}>
        {b.titre && <p class="bloc__titre mono">{b.titre}</p>}

        {b.type === 'recette' && (
          <ul class="recette" role="list">
            {b.lignes.map((l) => (
              <li class="recette__ligne">
                <span class="recette__test" set:html={inline(l.test)} />
                {l.attendu && <span class="recette__attendu"><span class="mono">Attendu</span> {l.attendu}</span>}
                <span class="recette__res"><Statut statut={l.statut} /> {l.obs && <span set:html={inline(l.obs)} />}</span>
              </li>
            ))}
          </ul>
        )}

        {b.type === 'etapes' && (
          <ol class="etapes" role="list">
            {b.etapes.map((e) => (
              <li><span class="mono etapes__label">{e.label}</span><span set:html={inline(e.texte)} /></li>
            ))}
          </ol>
        )}

        {b.type === 'code' && (
          <pre class="code" data-lang={b.langage} tabindex="0" aria-label={b.titre ?? 'Extrait'}><code>{b.contenu.trimEnd()}</code></pre>
        )}

        {b.type === 'liste' && (
          <ul class="liste">
            {b.items.map((it) => <li set:html={inline(it)} />)}
          </ul>
        )}

        {b.type === 'tableau' && (
          <div class="tableau" tabindex="0" role="group" aria-label={b.titre}>
            <table>
              <thead><tr>{b.colonnes.map((c) => <th scope="col">{c}</th>)}</tr></thead>
              <tbody>
                {b.lignes.map((l) => (
                  <tr>{l.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    ))}

    {a.capture && (
      <figure class="capture">
        <div class="capture__vide" aria-hidden="true"><span class="mono">Capture à venir</span></div>
        <figcaption class="mono">{a.capture}</figcaption>
        <Fragment set:html={`<!-- TODO Mano : ${a.capture} -->`} />
      </figure>
    )}

    <p class="piece__montre"><strong>Ce que ça montre :</strong> <span set:html={inline(a.montre)} /></p>
    <p class="piece__source mono">Source : {a.source}{a.note && <span class="piece__note"> · {a.note}</span>}</p>
  </div>
</div>

<style>
  .claim { margin-block: var(--space-5); }

  .claim__line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    max-width: none;
    margin: 0;
  }
  .claim__text {
    font-family: var(--f-title);
    font-stretch: 100%;
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.3;
    text-decoration: underline dashed var(--accent) 1.5px;
    text-underline-offset: 0.28em;
  }
  .claim__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap);
    min-width: var(--tap);
    padding: 0 0.95rem;
    font-family: var(--f-mono);
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--accent-ink);
    background: var(--paper-raised);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .claim__btn:hover { background: var(--accent-wash); }
  .claim__btn[aria-expanded='true'] { background: var(--accent-ink); border-color: var(--accent-ink); color: var(--on-accent); }
  .claim__arrow { display: inline-block; transition: transform 200ms var(--ease); }
  .claim__btn[aria-expanded='true'] .claim__arrow { transform: rotate(90deg); }

  .claim__check { display: none; color: var(--ok); font-size: 0.7rem; }
  :global(.claim.is-verified) .claim__check { display: inline; }

  /* La pièce jointe : feuille agrafée sous l'affirmation */
  .piece {
    position: relative;
    margin-top: var(--space-4);
    padding: var(--space-5) var(--space-4) var(--space-4);
    background: var(--paper-raised);
    border: var(--stroke) solid var(--line-strong);
    border-left: 3px solid var(--accent);
    box-shadow: 4px 4px 0 var(--grid-major);
    max-width: 52rem;
  }
  .piece:focus { outline: none; }
  .piece:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  :global(.js) .piece:not([hidden]) { animation: piece-in 320ms var(--ease); }
  @keyframes piece-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

  .piece__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-4)) var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-bottom: var(--stroke) dashed var(--line-strong);
    background: var(--paper-sunk);
  }
  .piece__tag { color: var(--accent-ink); }
  .piece__close {
    min-height: var(--tap);
    padding: 0 var(--space-3);
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    font-size: 0.72rem;
  }
  .piece__close:hover { color: var(--accent-ink); }

  .bloc + .bloc { margin-top: var(--space-5); }
  .bloc__titre { margin-bottom: var(--space-2); color: var(--ink); }

  .recette { list-style: none; margin: 0; padding: 0; border-top: var(--stroke) solid var(--line); }
  .recette__ligne {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    border-bottom: var(--stroke) solid var(--line);
    font-size: var(--fs-small);
  }
  .recette__test { font-weight: 600; }
  .recette__attendu { color: var(--ink-soft); }
  .recette__attendu .mono { font-size: 0.66rem; margin-right: 0.3rem; }
  .recette__res { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: baseline; }
  @media (min-width: 720px) {
    .recette__ligne { grid-template-columns: 1.3fr 0.8fr 1.4fr; gap: var(--space-4); align-items: baseline; }
  }

  .etapes { list-style: none; margin: 0; padding: 0; counter-reset: etape; }
  .etapes li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-2) 0 var(--space-2) var(--space-4);
    border-left: 1.5px solid var(--line-strong);
    position: relative;
  }
  .etapes li::before {
    content: '';
    position: absolute;
    left: -5px; top: 0.95rem;
    width: 8px; height: 8px;
    background: var(--paper-raised);
    border: 1.5px solid var(--ink);
    border-radius: 50%;
  }
  .etapes li:last-child::before { background: var(--accent); border-color: var(--accent); }
  .etapes__label { font-size: 0.68rem; color: var(--ink-faint); }
  @media (min-width: 720px) {
    .etapes li { grid-template-columns: 9rem 1fr; gap: var(--space-4); align-items: baseline; }
  }

  .code {
    margin: 0;
    padding: var(--space-4);
    overflow-x: auto;
    background: var(--ink);
    color: #f1ede4;
    font-size: 0.8rem;
    line-height: 1.6;
    border-radius: var(--radius);
  }
  .code:focus-visible { outline-offset: 2px; }

  .liste { margin: 0; padding-left: 1.2rem; display: grid; gap: var(--space-2); }
  .liste li { max-width: var(--measure); }
  .liste li::marker { color: var(--accent); }

  .tableau { overflow-x: auto; }
  .tableau table { border-collapse: collapse; width: 100%; font-size: var(--fs-small); min-width: 34rem; }
  .tableau th, .tableau td { text-align: left; padding: var(--space-2) var(--space-3); border-bottom: var(--stroke) solid var(--line); vertical-align: top; }
  .tableau thead th { font-family: var(--f-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-faint); font-weight: 500; }
  .tableau tbody th { font-weight: 600; }

  .capture { margin: var(--space-5) 0 0; }
  .capture__vide {
    display: grid;
    place-items: center;
    min-height: 8rem;
    border: 1.5px dashed var(--line-strong);
    background:
      repeating-linear-gradient(45deg, transparent 0 10px, var(--grid-minor) 10px 11px);
  }
  .capture figcaption { margin-top: var(--space-2); font-size: 0.68rem; }

  .piece__montre { margin: var(--space-5) 0 var(--space-2); padding-top: var(--space-3); border-top: var(--stroke) solid var(--line); }
  .piece__source { margin: 0; font-size: 0.68rem; text-transform: none; letter-spacing: 0.01em; }
</style>
