---
import { inline } from '../lib/text.js';
const { data } = Astro.props;
---
<section class="section" id="experience" aria-labelledby="experience-titre">
  <div class="wrap xp">
    <header class="section__head xp__head">
      <p class="mono section__label">Expérience</p>
      <h2 id="experience-titre" class="section__title">Thales,<br />Valence.</h2>
      <p class="section__intro">Stage puis alternance, sur une infrastructure en production.</p>
    </header>

    <ol class="jobs" role="list">
      {data.postes.map((p) => (
        <li class="job">
          <p class="mono job__meta"><span class="job__type">{p.type}</span> {p.periode}</p>
          <h3 class="job__title">{p.poste}</h3>
          <p class="job__where">{p.entreprise} · {p.lieu}</p>
          <ul class="job__points">
            {p.points.map((pt) => <li set:html={inline(pt)} />)}
          </ul>
          {p.lien && <a class="job__link" href={`#${p.lien.ancre}`}>{p.lien.texte} <span aria-hidden="true">→</span></a>}
          <ul class="tags job__tags" aria-label="Thèmes">{p.tags.map((t) => <li>{t}</li>)}</ul>
        </li>
      ))}
    </ol>

    <p class="xp__confid mono">{data.confidentialite}</p>

    <div class="edu">
      <h3 class="mono edu__title">Formation</h3>
      <ol class="edu__list" role="list">
        {data.formation.map((f) => (
          <li>
            <span class="mono edu__when">{f.periode}</span>
            <span class="edu__what">{f.titre}</span>
            <span class="edu__where">{f.lieu}{f.detail && ` · ${f.detail}`}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .xp { display: grid; }
  .jobs { list-style: none; padding: 0; display: grid; }
  .job { padding: var(--space-6) 0; border-top: 2px solid var(--dark); }
  .job + .job { border-top-width: 1px; border-top-color: var(--line); }
  .job__meta { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; color: var(--fg-mute); text-transform: none; font-size: 0.82rem; }
  .job__type { background: var(--dark); color: var(--light); padding: 0.2rem 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.7rem; }
  .job:first-child .job__type { background: var(--accent); }
  .job__title { font-size: var(--fs-xl); margin-top: var(--space-3); letter-spacing: -0.025em; }
  .job__where { margin-top: var(--space-1); color: var(--fg-mute); font-weight: 600; }
  .job__points { margin-top: var(--space-4); padding-left: 1.1rem; display: grid; gap: var(--space-2); max-width: 64ch; }
  .job__points li::marker { color: var(--accent); }
  .job__link { display: inline-flex; align-items: center; min-height: var(--tap); margin-top: var(--space-2); font-weight: 600; color: var(--accent); text-decoration: none; }
  .job__link:hover { text-decoration: underline; }
  .job__tags { margin-top: var(--space-4); }
  .xp__confid { color: var(--fg-mute); text-transform: none; letter-spacing: 0.01em; padding-top: var(--space-4); border-top: 1px solid var(--line); }

  .edu { margin-top: var(--space-7); }
  .edu__title { color: var(--fg-mute); font-weight: 500; letter-spacing: 0.04em; margin-bottom: var(--space-3); }
  .edu__list { list-style: none; padding: 0; }
  .edu__list li { display: grid; gap: 0.15rem; padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .edu__when { color: var(--fg-mute); text-transform: none; }
  .edu__what { font-weight: 650; }
  .edu__where { color: var(--fg-mute); font-size: var(--fs-sm); }

  @media (min-width: 960px) {
    .xp { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr); column-gap: var(--space-8); }
    .xp__head { grid-row: span 3; align-self: start; position: sticky; top: calc(var(--header-h) + var(--space-6)); }
    .edu__list li { grid-template-columns: 7.5rem minmax(0, 1fr); column-gap: var(--space-4); }
    .edu__where { grid-column: 2; }
  }
</style>
