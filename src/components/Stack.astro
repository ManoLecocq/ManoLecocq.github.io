---
const { data } = Astro.props;
---
<section class="section stack-s" id="stack" aria-labelledby="stack-titre">
  <div class="wrap">
    <header class="section__head">
      <p class="mono section__label">Stack</p>
      <h2 id="stack-titre" class="section__title">Les outils que j'ai utilisés.</h2>
      <p class="section__intro">Avec l'endroit où je m'en suis servi. Pas de niveau en pourcentage.</p>
    </header>

    <div class="domains">
      {data.domaines.map((d) => (
        <section class="domain" aria-labelledby={`dom-${d.nom}`}>
          <h3 id={`dom-${d.nom}`} class="domain__name">{d.nom}</h3>
          <ul class="domain__list" role="list">
            {d.outils.map((o) => (
              <li><span class="domain__tool">{o.nom}</span><span class="mono domain__where">{o.ou}</span></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-s { background: var(--dark); color: var(--on-dark); }
  .stack-s :global(.section__label), .stack-s :global(.section__intro) { color: var(--on-dark-mute); }
  .domains { display: grid; gap: var(--space-6); }
  .domain { border-top: 1px solid var(--on-dark-line); padding-top: var(--space-4); }
  .domain__name { font-size: 1.35rem; letter-spacing: -0.02em; margin-bottom: var(--space-3); }
  .domain__list { list-style: none; padding: 0; }
  .domain__list li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.15rem var(--space-3); padding: 0.55rem 0; border-bottom: 1px solid var(--on-dark-line); }
  .domain__tool { font-weight: 600; }
  .domain__where { color: var(--on-dark-mute); text-transform: none; letter-spacing: 0.01em; }
  @media (min-width: 720px) { .domains { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); } }
  @media (min-width: 1100px) { .domains { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-7); row-gap: var(--space-7); } }
</style>
