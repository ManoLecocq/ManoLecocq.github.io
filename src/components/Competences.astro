---
import Planche from './Planche.astro';
const { data, planche } = Astro.props;
---
<Planche num={planche.num} titre={planche.titre} id={planche.ancre} sousTitre={data.sous_titre}>
  <div class="matrice" data-matrice>
    <div class="matrice__filtres" role="group" aria-label="Mettre en évidence une compétence" data-matrice-filtres hidden>
      {data.competences.map((c) => (
        <button type="button" class="filtre" aria-pressed="false" data-comp={c.id}>
          <span class="filtre__nom">{c.nom}</span>
          <span class="filtre__detail">{c.detail}</span>
        </button>
      ))}
    </div>

    <div class="matrice__table" data-reveal>
      <table>
        <caption class="visually-hidden">Compétences du BUT R&T mobilisées par chaque projet</caption>
        <thead>
          <tr>
            <th scope="col" class="col-projet"><span class="mono">Projet</span></th>
            {data.competences.map((c) => (
              <th scope="col" data-col={c.id}>
                <abbr title={`${c.nom} ${c.detail}`} class="mono">{c.court}</abbr>
                <span class="th-long">{c.nom}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {data.lignes.map((l) => (
            <tr data-row={l.competences.join(' ')}>
              <th scope="row"><a href={`#${l.ancre}`}>{l.titre}</a></th>
              {data.competences.map((c) => {
                const oui = l.competences.includes(c.id);
                return (
                  <td data-col={c.id} class:list={[oui && 'is-yes']}>
                    <span aria-hidden="true">{oui ? '●' : '·'}</span>
                    <span class="visually-hidden">{oui ? 'oui' : 'non'}</span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="matrice__legende mono">ADM Administrer · CON Connecter · PRO Programmer · SÉC Sécuriser · SUR Surveiller</p>
  </div>
</Planche>

<script>
  // Choisir une compétence met en évidence sa colonne et les projets concernés.
  const root = document.querySelector<HTMLElement>('[data-matrice]');
  if (root) {
    const filtres = root.querySelector<HTMLElement>('[data-matrice-filtres]')!;
    const boutons = [...filtres.querySelectorAll<HTMLButtonElement>('button')];
    let actif: string | null = null;

    const afficher = (id: string | null) => {
      root.dataset.actif = id ?? '';
      root.querySelectorAll<HTMLElement>('[data-col]').forEach((el) => el.classList.toggle('is-col', el.dataset.col === id));
      root.querySelectorAll<HTMLElement>('[data-row]').forEach((tr) => {
        const on = !!id && tr.dataset.row!.split(' ').includes(id);
        tr.classList.toggle('is-on', on);
        tr.classList.toggle('is-off', !!id && !on);
      });
    };

    boutons.forEach((b) => {
      b.addEventListener('click', () => {
        actif = actif === b.dataset.comp ? null : b.dataset.comp!;
        boutons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.comp === actif)));
        afficher(actif);
      });
      // Survol (souris) : aperçu sans changer la sélection
      b.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') afficher(b.dataset.comp!); });
      b.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') afficher(actif); });
    });
    filtres.hidden = false;
  }
</script>

<style>
  .matrice__filtres { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); }
  .filtre {
    display: grid;
    text-align: left;
    min-height: var(--tap);
    padding: 0.45rem 0.8rem;
    background: var(--paper-raised);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    flex: 1 1 9.5rem;
  }
  .filtre__nom { font-family: var(--f-title); font-weight: 700; font-stretch: 110%; }
  .filtre__detail { font-size: 0.78rem; color: var(--ink-soft); line-height: 1.3; }
  .filtre:hover { background: var(--accent-wash); }
  .filtre[aria-pressed='true'] { background: var(--accent-ink); border-color: var(--accent-ink); color: var(--on-accent); }
  .filtre[aria-pressed='true'] .filtre__detail { color: var(--on-accent); }

  .matrice__table table { width: 100%; border-collapse: collapse; background: var(--paper-raised); border: 1.5px solid var(--ink); table-layout: fixed; }
  .matrice__table th, .matrice__table td { border: var(--stroke) solid var(--line); padding: var(--space-2); text-align: center; transition: background-color 200ms, opacity 200ms; }
  .matrice__table thead th { border-bottom: 1.5px solid var(--ink); font-weight: 500; }
  .col-projet { width: 42%; text-align: left !important; }
  .matrice__table tbody th { text-align: left; font-weight: 600; font-size: var(--fs-small); line-height: 1.25; }
  .matrice__table tbody th a { text-decoration-color: var(--line-strong); }
  .matrice__table abbr { text-decoration: none; font-size: 0.68rem; color: var(--ink); }
  .th-long { display: none; font-family: var(--f-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .matrice__table td { color: var(--line-strong); font-size: 1.1rem; }
  .matrice__table td.is-yes { color: var(--ink); }

  .matrice__table .is-col { background: var(--accent-wash); }
  .matrice__table td.is-col.is-yes { color: var(--accent-ink); }
  .matrice__table tr.is-on th { box-shadow: inset 3px 0 0 var(--accent); }
  .matrice__table tr.is-off { opacity: 0.38; }

  .matrice__legende { margin-top: var(--space-3); text-transform: none; font-size: 0.68rem; }

  @media (min-width: 720px) {
    .col-projet { width: 30%; }
    .matrice__table abbr { display: none; }
    .th-long { display: inline; }
    .matrice__legende { display: none; }
  }
</style>
