---
// Une section du site, présentée comme une planche numérotée d'un dossier technique.
interface Props { num: string; titre: string; id: string; sousTitre?: string }
const { num, titre, id, sousTitre } = Astro.props;
---
<section class="planche" id={id} aria-labelledby={`${id}-titre`}>
  <div class="wrap">
    <header class="planche__head" data-reveal>
      <span class="planche__num mono">Pl. {num}</span>
      <h2 id={`${id}-titre`}>{titre}</h2>
      {sousTitre && <p class="planche__sub">{sousTitre}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .planche {
    padding-block: var(--space-8);
    border-top: var(--stroke) solid var(--line);
  }
  .planche__head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    position: relative;
    padding-top: var(--space-4);
  }
  /* trait de cote au-dessus du titre */
  .planche__head::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3.5rem;
    height: 3px;
    background: var(--accent);
  }
  .planche__num { color: var(--accent-ink); }
  .planche__head h2 { font-size: var(--fs-h2); font-weight: 750; }
  .planche__sub { color: var(--ink-soft); font-size: var(--fs-lead); margin: 0; }
</style>
