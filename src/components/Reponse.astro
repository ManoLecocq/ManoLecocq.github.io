---
import Planche from './Planche.astro';
import { inline } from '../lib/text.js';
const { data, planche, certifications } = Astro.props;
const enCours = certifications.items.filter((c) => c.status === 'en cours');
const items = [
  ...data.comment.items,
  ...(enCours.length
    ? [`${data.comment.prefixe_certifs} ${enCours.map((c) => c.nom).join(' ; ')}.`]
    : []),
];
---
<Planche num={planche.num} titre={planche.titre} id={planche.ancre} sousTitre={data.sous_titre}>
  <div class="reponse">
    <div class="reponse__texte" data-reveal>
      {data.paragraphes.map((p) => <p set:html={inline(p)} />)}
    </div>
    <div class="reponse__cols">
      <section class="bloc-r bloc-r--manque" data-reveal>
        <h3 class="mono">{data.pas_encore.titre}</h3>
        <ul>{data.pas_encore.items.map((x) => <li set:html={inline(x)} />)}</ul>
      </section>
      <section class="bloc-r" data-reveal>
        <h3 class="mono">{data.comment.titre}</h3>
        <ul>{items.map((x) => <li set:html={inline(x)} />)}</ul>
      </section>
    </div>
    <p class="reponse__conclusion" data-reveal set:html={inline(data.conclusion)} />
  </div>
</Planche>

<style>
  .reponse__texte p { font-size: var(--fs-lead); }
  .reponse__cols { display: grid; gap: var(--space-5); margin-block: var(--space-6); }
  .bloc-r { padding: var(--space-5) var(--space-4); background: var(--paper-raised); border: 1.5px solid var(--ink); }
  .bloc-r--manque { border-style: dashed; background: transparent; }
  .bloc-r h3 { font-family: var(--f-mono); font-size: 0.74rem; font-weight: 500; color: var(--accent-ink); margin-bottom: var(--space-3); font-stretch: 100%; letter-spacing: 0.05em; }
  .bloc-r ul { margin: 0; padding-left: 1.2rem; display: grid; gap: var(--space-3); }
  .bloc-r li::marker { color: var(--accent); }
  .reponse__conclusion {
    font-family: var(--f-title);
    font-weight: 600;
    font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem);
    line-height: 1.35;
    max-width: 38ch;
    padding-left: var(--space-4);
    border-left: 3px solid var(--accent);
  }
  @media (min-width: 860px) { .reponse__cols { grid-template-columns: 1fr 1fr; } }
</style>
